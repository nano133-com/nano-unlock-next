# Copy this file to .env.local and fill it in. Never commit .env.local.

# Your own Nano address, from your wallet's Receive screen. Readers pay this address.
# The site never holds its key. There is no default: with no address the site shows a setup page.
NANO_ADDRESS=

# A long random text that only this site knows (32 characters or more). It signs the readers' passes.
# Make one with: openssl rand -base64 48
UNLOCK_SECRET=

# Optional. The Nano node that proves the payments. Default: https://node.nano133.com/rpc
# NANO_NODE_URL=

# Optional. A second node. With it, a payment counts only when both nodes confirm it.
# NANO_NODE_URL_2=
