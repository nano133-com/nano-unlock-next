{
  "name": "@nano133/unlock",
  "version": "0.1.1",
  "description": "Sell part of a page for a few cents in Nano (XNO). The reader pays your own address; your site checks the payment at a Nano node. No key on your server, no database.",
  "keywords": [
    "nano",
    "xno",
    "paywall",
    "micropayments",
    "nextjs",
    "vercel",
    "unlock"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nano133-com/nano-unlock-next.git",
    "directory": "packages/unlock"
  },
  "homepage": "https://github.com/nano133-com/nano-unlock-next#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js"
    },
    "./client": {
      "types": "./dist/next/client.d.ts",
      "import": "./dist/next/client.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  },
  "peerDependencies": {
    "next": ">=15 <17",
    "react": ">=19 <20"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "next": "16.3.8",
    "react": "^19.2.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
